FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libespeak-ng1 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir piper-tts==1.8.0
RUN mkdir /models && python -m piper.download_voices --download-dir /models pl_PL-darkman-medium
WORKDIR /app
COPY *.py /app/
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
CMD ["python", "-u", "/app/dj_worker.py"]
