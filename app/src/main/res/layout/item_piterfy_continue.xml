 android:textColor="?attr/colorOnSurfaceVariant" app:layout_constraintStart_toStartOf="@id/continue_listening_title_label" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/continue_listening_title_label"/>
 <TextView android:id="@+id/continue_listening_resume_label" android:layout_width="0dp" android:layout_height="wrap_content"
