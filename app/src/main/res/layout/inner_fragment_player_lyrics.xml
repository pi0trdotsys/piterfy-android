<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/piterfy_lyrics_background" android:paddingHorizontal="20dp" android:paddingTop="12dp">
    <TextView android:id="@+id/lyrics_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:textColor="#B8D9C3" android:textSize="12sp" android:text="Szukam tekstu…" />
    <androidx.core.widget.NestedScrollView android:id="@+id/now_playing_song_lyrics_sroll_view"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <!-- tekst bez synchronizacji: zwykły, duży tekst (bez karaoke) -->
            <TextView android:id="@+id/now_playing_song_lyrics_text_view" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="60dp" android:paddingBottom="120dp" android:textSize="28sp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:lineSpacingExtra="7dp" android:gravity="start" />
            <!-- tekst synchronizowany: jedna PiterfyLyricLineView na linijkę (styl Apple Music) -->
            <LinearLayout android:id="@+id/lyrics_lines_container" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="40dp" android:paddingBottom="260dp" android:clipChildren="false" android:clipToPadding="false" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/sync_lyrics_tap_button" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="48dp" android:paddingHorizontal="4dp" android:minWidth="0dp" android:textSize="12sp" android:text="Wróć do tekstu" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/lyrics_timing_button" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:paddingHorizontal="4dp" android:minWidth="0dp" android:textSize="12sp" android:layout_marginStart="6dp" android:text="0,0 s" android:contentDescription="Korekta synchronizacji tekstu" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/download_lyrics_button" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:paddingHorizontal="4dp" android:minWidth="0dp" android:textSize="12sp" android:layout_marginStart="6dp" android:text="Offline" android:contentDescription="Zapisz tekst do odczytu offline" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/lyrics_extras_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/translate_lyrics_button" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:paddingHorizontal="4dp" android:minWidth="0dp" android:textSize="12sp" android:text="@string/lyrics_translate" android:contentDescription="@string/lyrics_translate_cd" />
            <com.google.android.material.button.MaterialButton android:id="@+id/share_lyric_button" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:paddingHorizontal="4dp" android:minWidth="0dp" android:textSize="12sp" android:layout_marginStart="6dp" android:text="@string/lyrics_share_line" android:contentDescription="@string/lyrics_share_line_cd" />
        </LinearLayout>
</LinearLayout>
