<?xml version="1.0" encoding="utf-8"?>
<!-- TV: powitanie + szybkie akcje. Pierwsza pozycja listy, wiec przewija sie razem z rzedami. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_home_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_family"
        android:textColor="#FFFFFFFF"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_home_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_family"
        android:text="@string/piterfy_tv_hint_home"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tv_home_action_play"
            style="@style/PiterfyTvPill"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/piterfy_tv_shuffle_all" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tv_home_action_now_playing"
            style="@style/PiterfyTvPill"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="@string/piterfy_tv_open_player"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tv_home_action_favorites"
            style="@style/PiterfyTvPill"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="@string/piterfy_tv_favorites" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tv_home_action_search"
            style="@style/PiterfyTvPill"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="@string/piterfy_tv_search" />
    </LinearLayout>
</LinearLayout>
