<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.tabs.TabLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@android:color/transparent"
    app:tabBackground="@drawable/piterfy_chip_bg"
    app:tabGravity="start"
    app:tabIndicatorHeight="0dp"
    app:tabMinWidth="0dp"
    app:tabMode="scrollable"
    app:tabPaddingEnd="14dp"
    app:tabPaddingStart="14dp"
    app:tabRippleColor="@null"
    app:tabSelectedTextColor="#FF000000"
    app:tabTextAppearance="@style/PiterfyChipText"
    app:tabTextColor="@color/piterfy_chip_text" />
