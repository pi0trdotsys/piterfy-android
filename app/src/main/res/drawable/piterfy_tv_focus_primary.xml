<?xml version="1.0" encoding="utf-8"?>
<!-- TV: glowny przycisk akcji (Odtwarzaj) - bialy, po fokusie z gruba obwodka. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="4dp" android:color="#FFFFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F2FFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
