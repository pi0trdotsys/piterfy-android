<?xml version="1.0" encoding="utf-8"?>
<!-- TV: glowny przycisk Play/Pauza - bialy krag, po fokusie z grubym halo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke android:width="5dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <solid android:color="#F2FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
