<?xml version="1.0" encoding="utf-8"?>
<!-- Piterfy: zakladki jako "chipsy" Spotify: zielony wybrany, ciemnoszary reszta.
     Bez <inset> - inset dawal tlu padding, ktory nadpisywal wewnetrzne odstepy zakladki. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1ED760" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2A2A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
