<?xml version="1.0" encoding="utf-8"?>
<!-- Piterfy: zakladki jako "chipsy" Spotify: zielony wybrany, ciemnoszary reszta -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF1ED760" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF2A2A2A" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
