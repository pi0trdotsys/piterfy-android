<resources>
 <style name="PiterfyShapeSmall" parent="ShapeAppearance.Material3.SmallComponent"><item name="cornerSize">12dp</item></style>
 <style name="PiterfyShapeMedium" parent="ShapeAppearance.Material3.MediumComponent"><item name="cornerSize">18dp</item></style>
 <style name="PiterfyButton" parent="Widget.Material3.Button">
 <item name="cornerRadius">24dp</item><item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item>
 <item name="android:fontFamily">@font/figtree_family</item><item name="android:textStyle">bold</item></style>
 <style name="PiterfyCard" parent="Widget.Material3.CardView.Elevated">
 <item name="cardCornerRadius">12dp</item><item name="cardElevation">0dp</item><item name="strokeWidth">0dp</item>
 <item name="cardBackgroundColor">?attr/colorSurface</item></style>

 <style name="PiterfyChipText" parent="TextAppearance.Material3.LabelLarge">
  <item name="android:textSize">14sp</item><item name="android:textStyle">bold</item>
  <item name="android:fontFamily">@font/figtree_family</item><item name="textAllCaps">false</item>
 </style>
 <style name="PiterfyNavLabelActive" parent="TextAppearance.Material3.LabelSmall">
  <item name="android:textSize">11sp</item><item name="android:textStyle">bold</item>
  <item name="android:fontFamily">@font/figtree_family</item>
 </style>
 <style name="PiterfyNavLabelInactive" parent="TextAppearance.Material3.LabelSmall">
  <item name="android:textSize">11sp</item><item name="android:textStyle">normal</item>
  <item name="android:fontFamily">@font/figtree_family</item>
 </style>
 <style name="PiterfyNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
  <item name="android:color">@android:color/transparent</item>
 </style>
 <style name="PiterfyBottomNav" parent="Widget.Material3.BottomNavigationView">
  <item name="android:background">@drawable/piterfy_nav_bg</item>
  <item name="backgroundTint">@null</item>
  <item name="itemIconTint">@color/piterfy_nav_item</item>
  <item name="itemTextColor">@color/piterfy_nav_item</item>
  <item name="itemActiveIndicatorStyle">@style/PiterfyNavIndicator</item>
  <item name="itemTextAppearanceActive">@style/PiterfyNavLabelActive</item>
  <item name="itemTextAppearanceInactive">@style/PiterfyNavLabelInactive</item>
  <item name="labelVisibilityMode">labeled</item>
  <item name="elevation">0dp</item>
 </style>
</resources>